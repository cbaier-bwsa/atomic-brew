# Containerfile.noctalia — Noctalia-Shell auf der Hyprland-Basis
FROM ghcr.io/cbaier-bwsa/atomic-brew:hypr

RUN dnf -y install noctalia && \
    dnf clean all && \
    rm -rf /var/cache/libdnf5 /var/lib/dnf /var/log/* /var/cache/ldconfig/* \
           /run/dnf /run/svnserve

# Overlay: /etc/skel-Config für Hyprland/Noctalia. Noctalia bringt seit einer neueren
# Paketversion selbst einen /etc/xdg/autostart-Eintrag mit (/usr/etc/xdg/autostart/
# dev.noctalia.Noctalia.desktop, Exec=noctalia --daemon) — der frühere Stand ("weder
# Hyprland noch Noctalia selbst einen Autostart-Eintrag", siehe .docs/11) gilt für
# Noctalia nicht mehr; deshalb hier bewusst KEIN eigener noctalia-exec-once mehr
# (siehe Kommentar unten zum hyprland.lua-Hook).
COPY overlay-noctalia/ /

# Verhindert Hyprlands Auto-Generierung von ~/.config/hypr/hyprland.lua, die dabei die
# "autogenerated config"-Warnung aktiviert (überlagert die Noctalia-Bar auf zwei Monitoren,
# siehe .docs/11). Kopiert stattdessen das Stock-Template des installierten Hyprland-Pakets, damit
# das bei künftigen Hyprland-Versionen automatisch mitzieht statt zu veralten.
# ibus-daemon läuft in keiner Hyprland-Session automatisch mit (kein Autostart-Eintrag im
# ibus-Paket) — ohne ihn stürzt org.freedesktop.portal.IBus ("Not connected to the ibus bus")
# ab, sobald eine App (z.B. Obsidian) den IBus-Portal anfragt, und erzeugt eine "Failed unit
# detected"-Meldung. Der primäre Fix dafür ist overlay-hypr/etc/xdg/autostart/ibus-daemon.desktop
# (siehe .docs/15); dieser exec-once bleibt zusätzlich als Fallback, analog zum bisherigen Muster.
# noctalia --daemon dagegen NICHT mehr hier starten: race gegen Noctalias eigenen
# /etc/xdg/autostart-Eintrag (siehe COPY-Kommentar oben) — beide starten bei jedem
# Hyprland-(Neu-)Start, der Verlierer bricht mit "noctalia is already running" ab und
# erzeugt eine "Failed unit detected"-Meldung für app-dev.noctalia.Noctalia@autostart.service
# (verifiziert per journalctl, .docs/15 Nachtrag).
# Der Stock-Menu-Bind (SUPER+R) zeigt auf "hyprlauncher", das im Image nicht installiert ist —
# stattdessen auf Noctalias eigenen Launcher (Bar) umbiegen.
RUN cp /usr/share/hypr/hyprland.lua /etc/skel/.config/hypr/hyprland.lua && \
    printf '\nhl.on("hyprland.start", function()\n    hl.exec_cmd("ibus-daemon -drxs")\nend)\n' \
        >> /etc/skel/.config/hypr/hyprland.lua && \
    sed -i 's/^local menu.*/local menu        = "noctalia msg panel-toggle launcher"/' \
        /etc/skel/.config/hypr/hyprland.lua

RUN bootc container lint

LABEL org.opencontainers.image.title="Atomic Brew (Noctalia)" \
      org.opencontainers.image.description="Atomic Brew Hyprland-Basis + Noctalia-Shell" \
      containers.bootc="1"
