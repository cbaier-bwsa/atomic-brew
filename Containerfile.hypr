# Containerfile.hypr — Hyprland-Desktop auf der Toolchain-Basis
FROM ghcr.io/cbaier-bwsa/atomic-brew:base

# Hyprland ist kein offizielles Fedora-Paket (keine Comps-Gruppe, kein Standard-Repo) —
# Quelle: COPR lionheartp/Hyprland (aktiv gepflegt, F44-Ziel, per Copr-API verifiziert).
# Baut den kompletten Hyprland-Bibliotheksstack konsistent aus einer Quelle, inkl.
# hyprland-guiutils — im Gegensatz zu ashbuk/Hyprland-Fedora (vorherige Quelle), das
# seine Abhängigkeiten privat vendort und hyprland-guiutils nicht mitbaute.
# gnome-keyring-pam liefert pam_gnome_keyring.so, das /etc/pam.d/sddm bereits referenziert
# (optional, "-" Präfix). Ohne das Paket bleibt der Login-Keyring beim SDDM-Login ungeöffnet,
# und jede App, die Secret Service nutzt (z.B. Vivaldi), fragt bei jedem Start erneut das
# Keyring-Passwort ab, statt es automatisch mit dem SDDM-Login-Passwort zu entsperren.
#
# sddm-breeze bewusst NICHT installieren: sddm erwartet zwar "01-breeze-fedora" als
# einkompilierten Default, aber das Paket zieht über plasma-workspace ~240 Pakete / ~1 GiB
# (kwin, xdg-desktop-portal-kde, qt6-qtwebengine, xwaylandvideobridge …) nach. Stattdessen
# setzt overlay-hypr/etc/sddm.conf.d/theme.conf Current= leer -> eingebettetes Theme, ohne
# "configured theme ... doesn't exist"-Warnung.
RUN dnf -y copr enable lionheartp/Hyprland && \
    dnf -y --exclude=kitty install \
        hyprland xdg-desktop-portal-hyprland hyprlock hypridle hyprland-guiutils \
        hyprpaper mako sddm sddm-wayland-generic gnome-keyring-pam && \
    dnf -y --repo=fedora --repo=updates install kitty && \
    dnf clean all && \
    rm -rf /var/cache/libdnf5 /var/lib/dnf /var/log/* /var/cache/ldconfig/* \
           /run/dnf /run/svnserve

# Autostart-Eintrag für ibus-daemon. Kein Hyprland-/ibus-Paket bringt selbst einen mit; ohne
# laufenden ibus-daemon bricht org.freedesktop.portal.IBus ab, sobald eine App (z.B. Obsidian)
# den IBus-Input-Method-Portal anfragt ("Failed unit detected", siehe .docs/15). Bewusst als
# /etc/xdg/autostart-Eintrag statt exec-once in hyprland.conf/.lua: Autostart-Verzeichnisse
# werden bei jedem Login live gelesen, hyprland.conf/.lua dagegen nur über /etc/skel bei
# Useranlage — bei bereits bestehenden Usern kommt eine hyprland.conf/.lua-Änderung nie an
# (siehe .docs/11, Abschnitt "Autostart griff nicht").
#
# hyprpaper.desktop (gleiches Muster): setzt den Hintergrund aus ~/.config/hypr/hyprpaper.conf.
# Ersetzt Noctalias eigenen Wallpaper-Overwrite (dessen Anzeige mit Zeitversatz startet) als
# alleinige Quelle des Hintergrunds; wallpaper.enabled=false gehört dazu in Noctalias
# settings.toml (Runtime-State unter ~/.local/state, nicht Teil des Images).
#
# usr/share/uwsm/env-hyprland: gnome-keyring-pam (s.o.) entsperrt den Login-Keyring zwar korrekt
# über den "sddm"-PAM-Stack, aber sddm-wayland-generic übernimmt die dabei von pam_gnome_keyring
# gesetzten Variablen (GNOME_KEYRING_CONTROL/SSH_AUTH_SOCK) nicht in die exec'te Session — live
# verifiziert per `/proc/<Hyprland-PID>/environ`: keine der beiden Variablen kommt dort an. Fragt
# danach eine App den Secret Service (org.freedesktop.secrets) an, aktiviert D-Bus einen zweiten
# gnome-keyring-daemon; der findet den bereits entsperrten Login-Keyring aber eigenständig über
# den festen Pfad $XDG_RUNTIME_DIR/keyring/control ("discover_other_daemon: 1") und braucht daher
# kein neues Passwort — secrets/pkcs11 funktionieren also auch ganz ohne Environment-Variablen.
# (Ein erster, hier verworfener Versuch nahm fälschlich an, systemd --user kenne die Variablen
# nur deshalb nicht, weil dessen eigener PAM-Stack pam_gnome_keyring nicht einbindet, und wollte
# das per UWSM_ALWAYS_EXPORT_VARNAMES beheben — half nicht, weil die Variablen schon vorher, in
# Hyprlands eigenem Environment, fehlten.)
#
# Für SSH gibt es diesen impliziten Fallback nicht: ssh-Clients brauchen SSH_AUTH_SOCK explizit
# gesetzt, und der ssh-Bestandteil von gnome-keyring startet unter Hyprland ohnehin nie
# automatisch — sein Autostart-Eintrag (gnome-keyring-ssh.desktop, aus gnome-keyring-pam) trägt
# "OnlyShowIn=GNOME;Unity;MATE" und wird von uwsms XDG-Autostart-Filter für
# XDG_CURRENT_DESKTOP=Hyprland konsequent übersprungen. env-hyprland startet den ssh-Bestandteil
# deshalb direkt gegen den schon entsperrten Login-Keyring (kein neuer Prompt, s.o.) und
# übernimmt SSH_AUTH_SOCK aus dessen Ausgabe — landet dadurch als neue (in uwsms env_pre nicht
# vorhandene) Variable ganz regulär in dessen env_post und wird an den systemd-`--user`-Manager
# weitergegeben.
COPY overlay-hypr/ /

RUN bootc container lint

LABEL org.opencontainers.image.title="Atomic Brew (Hyprland)" \
      org.opencontainers.image.description="Atomic Brew Basis + Hyprland-Desktop" \
      containers.bootc="1"
