# /usr/lib/systemd/user/homebrew-bootstrap.service
[Unit]
Description=Homebrew Erstinstallation + Brewfile nach /var/home/linuxbrew
ConditionPathExists=!/var/home/linuxbrew/.linuxbrew/bin/brew
After=default.target podman-user-wait-network-online.service
Wants=podman-user-wait-network-online.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/homebrew-bootstrap.sh
# Exit-Code 91 = homebrew-bootstrap.sh hat mangels Internetverbindung abgebrochen (eigene
# notify-send-Meldung statt "failed unit"); wird dank SuccessExitStatus als Erfolg gewertet.
SuccessExitStatus=91
RemainAfterExit=yes

[Install]
WantedBy=default.target
